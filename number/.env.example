# FastAGI の待ち受けポート
AGI_PORT=4573

# クロールの起点になる自局の mantela.json の URL（既定は ab2m-ありあな局）
ROOT_MANTELA=https://allianaab2m.github.io/mantela/mantela.json
# 自局から何ホップ先まで辿るか
CRAWL_DEPTH=6
# 再クロールの間隔（例: "1 hour", "30 minutes"）
CRAWL_INTERVAL=1 hour

# --- 音声合成 ---
# openjtalk | voicevox （既定は openjtalk）
TTS_ENGINE=openjtalk

# Open JTalk（TTS_ENGINE=openjtalk のとき）
OPENJTALK_DIC=/var/lib/mecab/dic/open-jtalk/naist-jdic
OPENJTALK_VOICE=/usr/share/hts-voice/nitech-jp-atr503-m001/nitech_jp_atr503_m001.htsvoice

# VOICEVOX（TTS_ENGINE=voicevox のとき）
VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER=3

# --- 音声ファイルの置き場所 ---
# 音声を生成するローカルのディレクトリ
LOCAL_SOUNDS_DIR=./sounds
# PBX 上で音声が置かれる絶対パス（STREAM FILE に渡す）
PBX_SOUNDS_DIR=/storage/usbdisk1/mikopbx/media/custom/bango
# rsync の転送先。未設定なら同期しない
SYNC_TARGET=root@pbx:/storage/usbdisk1/mikopbx/media/custom/bango/
